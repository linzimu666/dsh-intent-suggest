{
  "name": "dsh-intent-suggest",
  "version": "0.0.1",
  "description": "替你思考还没打完的那半句：输入框上方实时长出三条方向不同、能直接发的任务候选，点一下只填回输入框",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node build.js",
    "test": "node build.js && node --test test/engine.test.js"
  },
  "files": [
    "lib",
    "engine",
    "client.js",
    "client.src.js",
    "build.js",
    "cordis.patch.yml",
    "docs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linzimu666/dsh-intent-suggest.git"
  },
  "homepage": "https://github.com/linzimu666/dsh-intent-suggest#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT"
}
